+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Virt SMP controller (m68k virt machine)
+ */
+
+#ifndef VIRT_SMP_H
+#define VIRT_SMP_H
+
+#include "hw/core/sysbus.h"
+#include "qemu/timer.h"
+
+#define TYPE_VIRT_SMP "virt-smp"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtSMPState, VIRT_SMP)
+
+#define VIRT_SMP_MAX_CPUS   16
+#define VIRT_SMP_NUM_LEVELS 7   /* device inputs: IPL 1..7 */
+
+typedef struct VirtSMPState VirtSMPState;
+
+typedef struct VirtSMPCPUState {
+    VirtSMPState *s;
+    QEMUTimer *timer;
+    int64_t timer_deadline;
+
+    uint32_t running;
+    uint32_t ipi_pending;
+    uint32_t ipi_config;
+    uint32_t timer_ctrl;
+    uint32_t timer_interval;
+    uint32_t timer_status;
+    uint32_t timer_config;
+    uint32_t counter_hi;
+    uint32_t start_pc;
+    uint32_t start_sp;
+    uint32_t start_arg;
+} VirtSMPCPUState;
+
+struct VirtSMPState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t num_cpus;
+
+    uint32_t dev_ipr;       /* asserted device inputs, bit L-1 for IPL L */
+    uint32_t devirq_route;
+
+    VirtSMPCPUState cpu[VIRT_SMP_MAX_CPUS];
+};
+
+#endif
