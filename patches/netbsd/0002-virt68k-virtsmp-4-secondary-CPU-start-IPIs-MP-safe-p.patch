+#define	VIRTSMP_CPU_CTRL	0xc
+
+/* reset values of IPI_CONFIG and TIMER_CONFIG (both at IPL 6) */
+#define	VIRTSMP_IPI_VECTOR	0x40
+#define	VIRTSMP_TIMER_VECTOR	0x41
+
+#endif /* _VIRT68K_VIRTSMPREG_H_ */
