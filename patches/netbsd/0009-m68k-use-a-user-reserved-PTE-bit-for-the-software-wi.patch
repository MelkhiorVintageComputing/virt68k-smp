From ebc7a7eb06512da631923628bf9c40e07a97d14c Mon Sep 17 00:00:00 2001
From: Romain Dolbeau <romain@dolbeau.org>
Date: Mon, 26 Oct 2026 17:28:08 +0100
Subject: [PATCH 09/10] m68k: use a user-reserved PTE bit for the software
 wired flag

PG_W was bit 8, which on the 68040/68060 is U0, a "user page attribute"
bit that the CPU drives on its UPA0 pin for the bus cycles to the page
(and keeps in the ATC).  Motorola recommends connecting UPA0/UPA1 to the
snoop control inputs on multiprocessor systems, and some boards give
them other uses (the atari Milan drives the PLX9080 endianness with U0),
so every wired page had a hardware side effect.  <m68k/mmu_40.h> already
says that U0/U1 must not be used as software bits.

Use bit 11 instead: PTE40_UR (user reserved) on the 040/060, an unused
page-address bit of the 851/030 short format, as bit 8 was.  It is below
PG_SHIFT on all ports (asserted).  Only the bit value changes: all the
users go through PG_W.  With a bit the MMU ignores, the existing
"wiring-only change needs no TLB flush" shortcuts are now correct.
---
 sys/arch/m68k/include/pte_motorola.h | 9 ++++++++-
 sys/arch/m68k/m68k/pmap_motorola.c   | 9 +++++++--
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/sys/arch/m68k/include/pte_motorola.h b/sys/arch/m68k/include/pte_motorola.h
index 1b713ea3f..f8046f3cb 100644
--- a/sys/arch/m68k/include/pte_motorola.h
+++ b/sys/arch/m68k/include/pte_motorola.h
@@ -97,7 +97,14 @@ typedef u_int	pt_entry_t;	/* page table entry */
 #define	PG_U		PTE51_U		/* == PTE40_U */
 #define	PG_M		PTE51_M		/* == PTE40_M */
 #define	PG_CI		PTE51_CI
-#define	PG_W		__BIT(8)	/* 851 unused bit XXX040 PTE40_U0 */
+/*
+ * PG_W (wired) is a software bit.  It must be ignored by every MMU: an
+ * unused page-address bit of the 851/030 short format (PG_SHIFT >= 12),
+ * the "user reserved" PTE40_UR bit of the 040/060.  Not U0/U1 (bits 8
+ * and 9): the 040/060 drive them on the UPA0/UPA1 pins (snoop control
+ * on multiprocessor boards, or board-specific uses), see <m68k/mmu_40.h>.
+ */
+#define	PG_W		__BIT(11)	/* 851 unused bit, 040 PTE40_UR */
 #define	PG_FRAME	((~0U) << PG_SHIFT)
 #define	PG_PFNUM(x)	(((uintptr_t)(x) & PG_FRAME) >> PG_SHIFT)
 
diff --git a/sys/arch/m68k/m68k/pmap_motorola.c b/sys/arch/m68k/m68k/pmap_motorola.c
index 7967c977a..320390925 100644
--- a/sys/arch/m68k/m68k/pmap_motorola.c
+++ b/sys/arch/m68k/m68k/pmap_motorola.c
@@ -137,6 +137,9 @@ __KERNEL_RCSID(0, "$NetBSD: pmap_motorola.c,v 1.89 2024/01/19 03:35:31 thorpej E
 
 #include <m68k/cacheops.h>
 
+/* the software wired bit is never part of the page frame */
+CTASSERT(PG_W < __BIT(PG_SHIFT));
+
 #if !defined(M68K_MMU_MOTOROLA) && !defined(M68K_MMU_HP)
 #error Hit the road, Jack...
 #endif
@@ -1388,7 +1391,8 @@ validate:
 
 	/*
 	 * Remember if this was a wiring-only change.
-	 * If so, we need not flush the TLB and caches.
+	 * If so, we need not flush the TLB and caches: PG_W is a software
+	 * bit that the MMU ignores and does not keep in the ATC.
 	 */
 
 	wired = ((*pte ^ npte) == PG_W);
@@ -1609,7 +1613,8 @@ pmap_unwire(pmap_t pmap, vaddr_t va)
 	/*
 	 * If wiring actually changed (always?) clear the wire bit and
 	 * update the wire count.  Note that wiring is not a hardware
-	 * characteristic so there is no need to invalidate the TLB.
+	 * characteristic (PG_W is ignored by the MMU and not kept in the
+	 * ATC) so there is no need to invalidate the TLB.
 	 */
 
 	if (pmap_pte_w_chg(pte, 0)) {
-- 
