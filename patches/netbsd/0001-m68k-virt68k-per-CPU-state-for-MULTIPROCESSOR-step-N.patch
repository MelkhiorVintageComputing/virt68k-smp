 	movl	8(%sp),%a0		| get newlwp
-	movl	%a0,_C_LABEL(curlwp)	| curlwp = new lwp
 	movl	L_PCB(%a0),%a1		| get its pcb
+#ifdef MULTIPROCESSOR
