+static void
+pmap_tlb_batch_free(struct pmap_tlb_batch *b)
+{
+	struct vm_page *pg;
+	struct pv_entry *pv;
+	vaddr_t stab;
+
+	/* (the user PT pages have no object, see pmap_enter_ptpage()) */
+	while ((pg = TAILQ_FIRST(&b->tb_freeptp)) != NULL) {
