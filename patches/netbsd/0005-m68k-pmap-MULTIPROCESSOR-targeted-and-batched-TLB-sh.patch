+struct pmap_tlb_req {
+	pmap_t		tr_pm;
+	u_int		tr_flags;
+	u_int		tr_nva;		/* PMAP_TLB_MAXVA + 1: everything */
+	volatile uint32_t tr_pending;	/* CPUs that have not done it yet */
+	const vaddr_t	*tr_va;
+};
